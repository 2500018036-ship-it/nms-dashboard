# Semua VITE_* merupakan konfigurasi PUBLIK di bundle browser. Jangan isi secret.
VITE_NMS_API_ENABLED=false
VITE_NMS_API_BASE=/nms-api

# Opsional untuk dev saja: backend/gateway yang sudah tersedia di loopback.
# Jalankan tunnel SSH privat sebelum dev server. Tanpa password/token dalam URL.
# NMS_API_TARGET=http://127.0.0.1:18765
