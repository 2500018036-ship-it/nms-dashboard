TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_ID=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Pisahkan koma. Hanya model yang diverifikasi tersedia; kosong = tanpa fallback.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LOG_LEVEL=INFO
DATA_DIR=/data
# Required for the credential vault. Generate once with:
# python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
# Keep the value only in the backend .env file (mode 600); never put it in the frontend.
NMS_CREDENTIALS_KEY=
SNAPSHOT_DIR=/collector
# Nama container maintenance yang memang boleh berhenti; status tetap ditampilkan.
DOCKER_IGNORED_CONTAINERS=
TARGETS_FILE=/app/targets.json
MONITOR_INTERVAL=60
RETENTION_DAYS=30
ALERTS_ENABLED=false
ALERT_CHAT_ID=
ALERT_COOLDOWN=600
DAILY_SUMMARY_ENABLED=false
CPU_THRESHOLD=90
MEMORY_THRESHOLD=90
STORAGE_THRESHOLD=90
MIKROTIK_HOST=192.168.20.1
MIKROTIK_PORT=8729
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_SSL_VERIFY=true
# CA internal harus dimount read-only ke path ini; jangan bypass verifikasi.
MIKROTIK_CA_FILE=
MIKROTIK_READONLY_CONFIRMED=false
MIKROTIK_ALLOW_PLAINTEXT=false
MIKROTIK_NETWORK_DETAILS_ENABLED=false
MIKROTIK_INTERFACES=
PROXMOX_URL=https://192.168.20.200:8006
PROXMOX_SSL_VERIFY=true
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_CA_FILE=
# VMID yang memang seharusnya running, pisahkan koma.
PROXMOX_EXPECTED_GUESTS=
# Dashboard hanya melalui loopback + SSH tunnel, username nms.
DASHBOARD_ENABLED=false
DASHBOARD_PASSWORD=

# Monitoring perubahan; hanya inventaris IPv4 privat pada network.json
CONTINUOUS_ENABLED=true
NETWORK_CONFIG_FILE=/app/network.json
NETWORK_INTERVAL=15
MIKROTIK_INTERFACE_EVENTS=true
# Kebijakan notifikasi trafik: RX dan TX nol 5 menit, pulih stabil 1 menit.
TRAFFIC_ZERO_SECONDS=300
TRAFFIC_RESUME_SECONDS=60
# Aturan relatif baseline lama dinonaktifkan; cocok hanya untuk profil khusus.
TRAFFIC_BASELINE_ALERTS_ENABLED=false
TRAFFIC_WARMUP_SAMPLES=5
TRAFFIC_MIN_BASELINE_BPS=100000
TRAFFIC_MIN_SPIKE_BPS=1000000
TRAFFIC_SPIKE_FACTOR=2
TRAFFIC_SPIKE_SECONDS=60
TRAFFIC_DROP_PERCENT=10
BANDWIDTH_WARNING_PERCENT=85
BANDWIDTH_CRITICAL_PERCENT=95
BANDWIDTH_SUSTAIN_SECONDS=30
BANDWIDTH_HYSTERESIS_PERCENT=5
WIREGUARD_STALE_SECONDS=180

# Fondasi manajemen: secret tetap di server. Default baru tidak mengaktifkan write.
MIKROTIK_MONITOR_ALLOW_ELEVATED=false
NMS_DEVICE_WRITES_ENABLED=false
# Proxmox sengaja tetap monitoring pada deployment saat ini.
PROXMOX_MANAGEMENT_ENABLED=false
PROXMOX_MANAGEMENT_TOKEN_ID=
PROXMOX_MANAGEMENT_TOKEN_SECRET=
